# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local:      mongodb://127.0.0.1:27017/service-provider-portal
# Atlas:      mongodb+srv://<user>:<password>@cluster0.mongodb.net/service-provider-portal
MONGO_URI=mongodb://127.0.0.1:27017/service-provider-portal

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Default admin (used by `npm run seed:admin`)
ADMIN_NAME=Portal Admin
ADMIN_EMAIL=admin@portal.com
ADMIN_PASSWORD=Admin@123

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173
