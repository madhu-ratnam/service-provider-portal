{
  "info": {
    "name": "Service Provider Onboarding Portal",
    "description": "API collection for the MERN Service Provider Onboarding Portal assignment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "providerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "providerId", "value": "" },
    { "key": "docId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Provider",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Kumar\",\n  \"email\": \"ravi@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login (Provider or Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ravi@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{providerToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Provider",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{providerToken}}" }],
            "url": "{{baseUrl}}/provider/profile"
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{providerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/provider/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\",\n  \"experienceYears\": 5,\n  \"serviceCategories\": [\"Electrician\", \"AC Repair\"],\n  \"skills\": [\"Wiring\", \"Panel repair\"],\n  \"location\": { \"address\": \"12 MG Road\", \"city\": \"Hyderabad\", \"state\": \"Telangana\", \"pincode\": \"500001\" }\n}"
            }
          }
        },
        {
          "name": "Upload Profile Photo",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{providerToken}}" }],
            "url": "{{baseUrl}}/provider/upload-photo",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "photo", "type": "file", "src": "" }]
            }
          }
        },
        {
          "name": "Upload Documents",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{providerToken}}" }],
            "url": "{{baseUrl}}/provider/upload-documents",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "documents", "type": "file", "src": "" }]
            }
          }
        },
        {
          "name": "Delete Document",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{providerToken}}" }],
            "url": "{{baseUrl}}/provider/documents/{{docId}}"
          }
        },
        {
          "name": "Get My Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{providerToken}}" }],
            "url": "{{baseUrl}}/provider/status"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List Providers (search/filter/paginate)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/admin/providers?search=&status=&category=&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "providers"],
              "query": [
                { "key": "search", "value": "" },
                { "key": "status", "value": "" },
                { "key": "category", "value": "" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Provider By Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/providers/{{providerId}}"
          }
        },
        {
          "name": "Approve Provider",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/providers/{{providerId}}/approve"
          }
        },
        {
          "name": "Reject Provider",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/admin/providers/{{providerId}}/reject",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"remarks\": \"ID proof document is blurry, please re-upload.\"\n}"
            }
          }
        },
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/stats"
          }
        }
      ]
    }
  ]
}
